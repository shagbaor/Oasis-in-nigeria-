# Copy to .env.local for local development, and add the same variables in Vercel
# (Project → Settings → Environment Variables).

# Neon connection string (Neon dashboard → Connect). Use the pooled one.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Password for signing in at /admin
ADMIN_PASSWORD="choose-a-long-password"

# Random secret for signing admin sessions, at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32+-character-string"
